# Motivational Shorts Studio - Backend Configuration Example
# Copy to .env and adjust values for your environment.

# API key required in the X-API-Key header to authenticate requests from n8n
SHORTS_API_KEY=dev-shorts-secret-key-2024

# Public base URL of the FastAPI service.
# For local dev with Cloudflare Quick Tunnel, set to your active trycloudflare.com URL:
PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com

# Directory for storing downloaded source files and rendered videos
MEDIA_DIR=./media

# Maximum allowed download file size in megabytes (protects disk and network)
MAX_DOWNLOAD_MB=250

# Maximum seconds allowed for an FFmpeg render subprocess before timing out
RENDER_TIMEOUT_SECONDS=300

# Comma-separated CORS allowed origins for browser access
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Retention hours for generated output videos (default: 48 hours)
MEDIA_RETENTION_HOURS=48

# ==============================================================================
# Google Sheets Integration
# ==============================================================================
# Path to service account JSON file, or set raw JSON content
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# ==============================================================================
# Multi-Platform Video Publishing Credentials
# ==============================================================================

# 1. YouTube Shorts (OAuth2 Credentials)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
YOUTUBE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_REFRESH_TOKEN=your-google-oauth-refresh-token
# YOUTUBE_ACCESS_TOKEN=your-temporary-bearer-token
# Initial upload visibility: private (recommended for testing) or public / unlisted
YOUTUBE_DEFAULT_PRIVACY=private

# 2. Discord (Webhook or Bot)
# To create a webhook: Discord Server Settings -> Integrations -> Webhooks -> New Webhook
# System default webhook (used automatically if no custom webhook is provided)
DEFAULT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1566147524891377846/dXkNoX_h4o-aMNOJTaoOe4gPGGgmSMDUqaI2iYLpveFleZitlM6-4TcsvddQ_0SKCaEh
# Custom Discord Webhook override (leave blank to use default, or paste your custom webhook here)
DISCORD_WEBHOOK_URL=
# Or use Bot token and Channel ID:
# DISCORD_BOT_TOKEN=your-discord-bot-token
# DISCORD_CHANNEL_ID=your-discord-channel-id

# 3. Telegram Channel (Bot API)
# System default credentials (used automatically if no custom bot token/chat ID is entered)
DEFAULT_TELEGRAM_BOT_TOKEN=9004895062:AAGZS4lwUumLy0130bOFwj7dZLM1dHWSK2I
DEFAULT_TELEGRAM_CHAT_ID=@lukizerkshorts
# Custom Telegram override (leave blank to use defaults above, or paste your custom bot token / channel handle)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 4. Instagram Reels (Meta Graph API)
# Requires an Instagram Professional (Creator or Business) Account linked to a Facebook Page
# Meta App with "instagram_content_publish" and "instagram_basic" permissions
INSTAGRAM_ACCOUNT_ID=your-instagram-business-account-id
META_ACCESS_TOKEN=your-long-lived-meta-page-or-user-access-token
META_API_VERSION=v19.0
